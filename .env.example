# Optional Bash configuration. Copy to .env.local and edit.
# Values in .env.local are loaded by scripts/server/activate.sh.
# By default the script uses your initialized Conda and environment name hawor.

# HAWOR_CONDA_ROOT=/path/to/miniforge3
# HAWOR_ENV_PREFIX=/path/to/envs/hawor

# A800 uses 8.0. Set this before building for a different GPU.
# TORCH_CUDA_ARCH_LIST=8.0
# MAX_JOBS=8
# OMP_NUM_THREADS=8
# PIP_CACHE_DIR=/path/to/cache/pip
